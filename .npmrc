# Required until Route A lands (see handoff tracked issues).
#
# vite-plugin-pwa@1.2.0 declares peer vite ^3||^4||^5||^6||^7 and the project
# is on vite ^8.0.4. Without this flag, plain `npm install` fails with ERESOLVE
# on a clean clone — it already did before firebase-tools was ever added.
#
# Route A (deferred, post-travel) bumps vite-plugin-pwa to ^1.3.0, whose peer
# range includes ^8.0.0. This file is removed at that same sitting so the
# resolver signal comes back.
legacy-peer-deps=true
